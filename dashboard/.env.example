DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD_HASH=replace-with-a-password_hash-output
DASHBOARD_COOKIE_SECURE=1

# SQL account for analytics and admin tools. Grant only the privileges listed in README.md.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=warriors_training_club
DB_USERNAME=dashboard_admin
DB_PASSWORD=replace-with-a-long-random-secret

# SMTP account used by the member mailing tool.
MAIL_HOST=smtp.example.org
MAIL_PORT=587
MAIL_USERNAME=replace-with-smtp-user
MAIL_PASSWORD=replace-with-smtp-password
MAIL_FROM=club@example.org
MAIL_FROM_NAME=Warriors Training Club
MAIL_ENCRYPTION=tls

# Optional GitHub API token to raise the unauthenticated rate limit.
GITHUB_TOKEN=

# Dedicated retention account. Grant DELETE on analytics_events only; it is not used by the web API.
ANALYTICS_MAINTENANCE_DB_HOST=127.0.0.1
ANALYTICS_MAINTENANCE_DB_PORT=3306
ANALYTICS_MAINTENANCE_DB_DATABASE=warriors_training_club
ANALYTICS_MAINTENANCE_DB_USERNAME=analytics_maintenance
ANALYTICS_MAINTENANCE_DB_PASSWORD=replace-with-a-separate-long-random-secret
